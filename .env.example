# Copy this file to .env for local development. .env is git-ignored: real keys
# stay out of the repo, out of chat and out of screenshots. Cloud Run takes real
# environment variables instead of a file. Restart `bun run dev` after editing.

# Which provider answers the Discovery agent: vertex (default) or apinex.
LLM_PROVIDER=vertex

# --- vertex: Gemini on Google Cloud (run `gcloud auth application-default login`)
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=asia-south1
GEMINI_FLASH_MODEL=gemini-3.5-flash

# --- apinex: https://apinex.bond, a third party that has not been vetted.
# Run infra/probe-apinex.sh first to learn the model name and wire format.
APINEX_API_KEY=
APINEX_MODEL=
# Typed trip requests may go to apinex only until this date (yyyy-mm-dd, UTC).
# Without it every request is refused and the rule parser answers. Employee
# records (calendar, email, receipts) never go, whatever this says.
ALLOW_THIRD_PARTY_LLM_UNTIL=
# Defaults to https://apinex.bond/v1 (openai) or https://apinex.bond/v1beta
# (google). Only https hosts on apinex.bond are accepted.
# APINEX_BASE_URL=
# Wire format of the gateway: openai (default) or google.
# APINEX_API_FORMAT=openai
# Set to true only if the gateway enforces a JSON schema (the probe checks).
# APINEX_JSON_SCHEMA=false

# Abort an LLM call after this many milliseconds.
# LLM_TIMEOUT_MS=20000
